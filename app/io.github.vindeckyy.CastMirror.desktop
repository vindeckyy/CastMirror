[Desktop Entry]
Version=1.0
Name=CastMirror
Comment=Send this PC's screen to a Chromecast or Cast TV
Exec=castmirror-gui
TryExec=castmirror-gui
Icon=io.github.vindeckyy.CastMirror
Terminal=false
Type=Application
Categories=AudioVideo;Video;Network;
StartupNotify=true
StartupWMClass=io.github.vindeckyy.CastMirror
Keywords=chromecast;cast;mirror;tv;display;
