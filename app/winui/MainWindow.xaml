<Window
    x:Class="CastMirror.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CastMirror">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Status Bar -->
        <Border Grid.Row="0" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock Text="CastMirror" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="6,2" Visibility="{x:Bind ViewModel.IsLiveVisible, Mode=OneWay}">
                        <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Settings" Click="OnOpenSettingsClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Display Preview Stage -->
            <Border Grid.Column="0" Margin="0,0,16,0" Background="#111115" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Image Source="{x:Bind ViewModel.LiveThumbnail, Mode=OneWay}" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.IsSearchingVisible, Mode=OneWay}">
                        <ProgressRing IsActive="True" Width="48" Height="48"/>
                        <TextBlock Text="Looking for Cast devices on your Wi-Fi..." Margin="0,12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Device Selector & Quality Controls -->
            <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock Text="Cast to TV" FontSize="16" FontWeight="SemiBold"/>

                <ListView ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding ModelName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Source Display Picker -->
                <TextBlock Text="Source Display" FontSize="14" FontWeight="Medium"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.Displays, Mode=OneWay}" SelectedIndex="0" HorizontalAlignment="Stretch"/>

                <!-- Quality Preset Selector -->
                <TextBlock Text="Quality Preset" FontSize="14" FontWeight="Medium"/>
                <Segmented SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <SegmentedItem Content="Auto"/>
                    <SegmentedItem Content="High"/>
                    <SegmentedItem Content="Balanced"/>
                    <SegmentedItem Content="Smooth"/>
                </Segmented>

                <!-- Audio Toggle -->
                <ToggleSwitch Header="System Audio" IsOn="{x:Bind ViewModel.AudioEnabled, Mode=TwoWay}"/>

                <!-- Primary Action Button -->
                <Button Content="{x:Bind ViewModel.ActionButtonText, Mode=OneWay}"
                        Background="{x:Bind ViewModel.ActionButtonBrush, Mode=OneWay}"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Padding="0,12"
                        HorizontalAlignment="Stretch"
                        Click="OnActionButtonClicked"/>
            </StackPanel>
        </Grid>

        <!-- Stats Drawer / Footer -->
        <Border Grid.Row="2" Padding="24,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <TextBlock Text="{x:Bind ViewModel.StatsFpsText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.StatsBitrateText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.StatsLatencyText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.StatsLossText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
