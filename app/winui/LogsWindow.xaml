<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CastMirror.LogsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CastMirror Logs">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="Diagnostic log" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center" FontSize="13"/>
            <ComboBox x:Name="LevelCombo" Grid.Column="1" MinWidth="110" SelectionChanged="OnLevelChanged"
                      AutomationProperties.Name="Level">
                <ComboBoxItem Content="Debug"/>
                <ComboBoxItem Content="Info"/>
                <ComboBoxItem Content="Warning"/>
                <ComboBoxItem Content="Error"/>
                <ComboBoxItem Content="Fatal"/>
            </ComboBox>
            <TextBox x:Name="FilterBox" Grid.Column="2" PlaceholderText="Filter"
                     AutomationProperties.Name="Filter logs"
                     TextChanged="OnFilterChanged" VerticalAlignment="Center"/>
            <Button Grid.Column="3" Content="Copy" Click="OnCopyClicked"
                    ToolTipService.ToolTip="Copy the selected lines, or every visible line if none are selected"/>
            <Button Grid.Column="4" Content="Copy for bug report" Click="OnCopyDiagnosticsClicked"
                    ToolTipService.ToolTip="Copies versions, settings and recent logs with network addresses masked"/>
            <Button Grid.Column="5" Content="Clear" Click="OnClearClicked"/>
            <Button Grid.Column="6" Content="Open folder" Click="OnOpenFolderClicked"/>
        </Grid>

        <ListView x:Name="LogList" Grid.Row="2" Margin="20,0,20,16"
                  ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                  SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"
                               TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
