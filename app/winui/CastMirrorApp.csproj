<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CastMirror</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <TargetName>CastMirror</TargetName>
    <AssemblyName>CastMirror</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- CastMirror.ico lives next to this file and is the same artwork the Linux
         packaging installs. Without ApplicationIcon the exe carries no icon at
         all, so Explorer, the taskbar and the tray (which extracts the exe icon)
         all showed the generic application icon. -->
    <ApplicationIcon>CastMirror.ico</ApplicationIcon>
    <!-- Product identity for Explorer's Details tab and for anything that reads
         the file version. Keep <Version> in step with project() in the root
         CMakeLists.txt (the single version source). -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>CastMirror</Product>
    <Company>CastMirror Maintainers</Company>
    <Description>Send this PC's screen to a Chromecast or Cast TV</Description>
    <!-- Ship English resources only. The default publish carries ~90 locale folders
         (over 100 MB) for languages the app does not translate yet. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Symbols stay out of release builds; CI keeps them as a separate artifact. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
  </ItemGroup>

  <!-- Translation tables: JSON objects mapping English UI text to a language. -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" LogicalName="Strings.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\build\core\castcore.dll" Condition="Exists('..\..\build\core\castcore.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>castcore.dll</Link>
    </None>
  </ItemGroup>

  <!-- The client is a thin shell over castcore.dll: with it missing the exe
       builds fine and then throws DllNotFoundException on the first call, or is
       packaged without its engine. Fail the build instead, naming the command
       that produces it (the copy above is conditional, so without this the
       absence is silent). -->
  <Target Name="EnsureCastCoreDll" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\build\core\castcore.dll')"
           Text="castcore.dll not found at build\core\castcore.dll. Build the native core first: cmake -S . -B build -G Ninja &amp;&amp; cmake --build build (MSYS2 UCRT64 toolchain)." />
  </Target>
</Project>
