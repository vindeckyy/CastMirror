<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CastMirror.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CastMirror Settings">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="20,16">
            <StackPanel Spacing="10" MaxWidth="620" HorizontalAlignment="Left">

                <!-- Picture &amp; encoding -->
                <Expander Header="Picture &amp; encoding" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14" Padding="4,10,4,4">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="BitrateLabel" Text="Video bitrate cap" FontWeight="Medium"/>
                            <TextBlock Text="Bitrate CastMirror holds while streaming. Drops only on network congestion and ramps back up quickly when the link recovers."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Slider x:Name="BitrateSlider" Maximum="25000" Minimum="1000" StepFrequency="500"
                                    SnapsTo="StepValues" ValueChanged="OnBitrateChanged" Margin="0,6,0,0"
                                    AutomationProperties.LabeledBy="{x:Bind BitrateLabel}"/>
                            <TextBlock x:Name="BitrateValueText" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Capture frame rate" FontWeight="Medium"/>
                            <TextBlock Text="Auto follows your monitor's refresh rate, capped at what the TV can decode. Most Cast devices stop at 30 or 60 fps."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="FpsCombo" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                      AutomationProperties.Name="Capture frame rate"
                                      SelectionChanged="OnFpsChanged">
                                <ComboBoxItem Content="Auto"/>
                                <ComboBoxItem Content="24 fps"/>
                                <ComboBoxItem Content="25 fps"/>
                                <ComboBoxItem Content="30 fps"/>
                                <ComboBoxItem Content="50 fps"/>
                                <ComboBoxItem Content="60 fps"/>
                            </ComboBox>
                        </StackPanel>

                        <ToggleSwitch x:Name="SteadySwitch" Header="Steady frame rate"
                                      OnContent="On" OffContent="Off" Toggled="OnSteadyToggled"/>
                        <TextBlock Margin="0,-8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Keeps resolution and frame rate fixed. Turn it off and CastMirror lowers the resolution when Wi-Fi gets congested."/>

                        <ToggleSwitch x:Name="SoftwareEncodeSwitch" Header="Force software encode"
                                      OnContent="On" OffContent="Off" Toggled="OnSoftwareEncodeToggled"/>
                        <TextBlock Margin="0,-8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Encodes on the CPU instead of the GPU. Try it if the picture glitches or the GPU encoder fails. Applies to the next cast."/>
                    </StackPanel>
                </Expander>

                <!-- Audio -->
                <Expander Header="Audio" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14" Padding="4,10,4,4">
                        <ToggleSwitch x:Name="AudioSwitch" Header="Computer sound"
                                      OnContent="On" OffContent="Off" Toggled="OnAudioToggled"/>
                        <TextBlock Margin="0,-8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Sends whatever your PC is playing to the TV. It follows the default speakers, so switching to headphones moves the audio with you."/>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Audio quality" FontWeight="Medium"/>
                            <TextBlock Text="Opus bitrate. 192 kbps is recommended; 64 kbps is best for weak Wi-Fi."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AudioQualityCombo" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                      AutomationProperties.Name="Audio quality"
                                      SelectionChanged="OnAudioQualityChanged">
                                <ComboBoxItem Content="64 kbps"/>
                                <ComboBoxItem Content="96 kbps"/>
                                <ComboBoxItem Content="128 kbps"/>
                                <ComboBoxItem Content="192 kbps"/>
                                <ComboBoxItem Content="256 kbps"/>
                            </ComboBox>
                        </StackPanel>


                    </StackPanel>
                </Expander>

                <!-- Latency &amp; buffering -->
                <Expander Header="Latency &amp; buffering" IsExpanded="False" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14" Padding="4,10,4,4">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="DelayLabel" Text="Target delay" FontWeight="Medium"/>
                            <TextBlock Text="How long the TV holds each frame before showing it. 200 ms keeps the pointer responsive. 400 ms rides out Wi-Fi retransmits. Game and Cinema presets set their own delay."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Slider x:Name="DelaySlider" Maximum="400" Minimum="100" StepFrequency="10"
                                    SnapsTo="StepValues" ValueChanged="OnDelayChanged" Margin="0,6,0,0"
                                    AutomationProperties.LabeledBy="{x:Bind DelayLabel}"/>
                            <TextBlock x:Name="DelayValueText" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="CursorSwitch" Header="Show the mouse pointer"
                                      OnContent="On" OffContent="Off" Toggled="OnCursorToggled"/>
                        <TextBlock Margin="0,-8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Draws the pointer into the mirrored picture. Applies to the next cast."/>

                        <ToggleSwitch x:Name="LatencyHudSwitch" Header="Latency HUD overlay"
                                      OnContent="On" OffContent="Off" Toggled="OnLatencyHudToggled"/>
                        <TextBlock Margin="0,-8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Draws frame rate, bitrate and round-trip time into the streamed picture."/>
                    </StackPanel>
                </Expander>

                <!-- Device discovery -->
                <Expander Header="Device discovery" IsExpanded="False" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14" Padding="4,10,4,4">
                        <ToggleSwitch x:Name="SubnetScanSwitch" Header="Scan the network for TVs"
                                      OnContent="On" OffContent="Off" Toggled="OnSubnetScanToggled"/>
                        <TextBlock Margin="0,-8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Connects to port 8009 on every address in your local subnet. Use it when your router blocks mDNS and TVs don't show up."/>
                    </StackPanel>
                </Expander>

                <!-- Desktop integration -->
                <Expander Header="Desktop integration" IsExpanded="False" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14" Padding="4,10,4,4">
                        <ToggleSwitch x:Name="TraySwitch" Header="Show a system tray icon"
                                      OnContent="On" OffContent="Off" Toggled="OnTrayToggled"/>
                        <TextBlock Margin="0,-8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Keeps an icon in the notification area so you can reopen the window or stop a cast. Closing the window with the tray on hides it there."/>

                        <ToggleSwitch x:Name="CloseToTraySwitch" Header="Closing window hides to tray"
                                      OnContent="On" OffContent="Off" Toggled="OnCloseToTrayToggled"/>
                        <TextBlock Margin="0,-8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="The close button hides the window instead of quitting, so a cast keeps running. Quit from the tray icon."/>

                        <ToggleSwitch x:Name="NotifySwitch" Header="Desktop notifications"
                                      OnContent="On" OffContent="Off" Toggled="OnNotifyToggled"/>
                        <TextBlock x:Name="NotifyHelpText" Margin="0,-8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Shows a notification when casting starts or stops, when the connection drops, and when a cast fails."/>
                    </StackPanel>
                </Expander>

                <!-- Appearance -->
                <Expander Header="Appearance" IsExpanded="False" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <TextBlock Text="Color scheme" FontWeight="Medium"/>
                        <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Color scheme"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="System default"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </Expander>

                <!-- Diagnostics -->
                <Expander Header="Diagnostics" IsExpanded="False" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4,10,4,4">
                        <Button Content="Run self-test" Click="OnSelfTestClicked"/>
                        <TextBlock x:Name="SelfTestText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="Open logs folder" Click="OnOpenLogsClicked"/>
                    </StackPanel>
                </Expander>

                <TextBlock x:Name="SaveErrorText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
