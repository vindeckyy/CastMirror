<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the client's pure logic. The services are compiled straight
       into this project instead of referencing the WinUI app: the app project
       needs the Windows App SDK runtime to load, these tests must run anywhere
       `dotnet test` does. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>CastMirror.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\app\winui\Services\UpdateService.cs" Link="Services\UpdateService.cs" />
    <Compile Include="..\..\app\winui\Services\DiagnosticsService.cs" Link="Services\DiagnosticsService.cs" />
    <Compile Include="..\..\app\winui\Services\LogService.cs" Link="Services\LogService.cs" />
    <Compile Include="..\..\app\winui\Services\CrashHandler.cs" Link="Services\CrashHandler.cs" />
    <Compile Include="..\..\app\winui\Services\Localizer.cs" Link="Services\Localizer.cs" />
  </ItemGroup>
</Project>
